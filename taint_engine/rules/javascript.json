{
  "language": "javascript",
  "extensions": [".js", ".jsx", ".ts", ".tsx"],
  "sources": {
    "req.body":          ["html", "sql", "shell", "ssrf"],
    "req.query":         ["html", "sql", "shell", "ssrf", "redirect"],
    "req.params":        ["html", "sql", "shell", "ssrf"],
    "req.headers":       ["html", "sql", "ssrf"],
    "document.location": ["html", "ssrf", "redirect"],
    "window.location":   ["html", "ssrf", "redirect"],
    "process.env":       ["path", "shell"]
  },
  "sinks": {
    "html": {
      "call":     ["document.write", "document.writeln"],
      "property": ["innerHTML", "outerHTML", "srcdoc"],
      "accepts":  ["html-encoded", "int", "float", "stripped"]
    },
    "eval": {
      "call":     ["eval", "setTimeout", "setInterval"],
      "accepts":  []
    },
    "ssrf": {
      "call":     ["fetch", "XMLHttpRequest"],
      "accepts":  ["validated-url", "int"]
    },
    "dom": {
      "property": [
        "src", "href", "action", "formAction",
        "onclick", "onerror", "onload", "onmouseover",
        "onfocus", "onblur", "onsubmit", "onchange",
        "onkeydown", "onkeyup", "onkeypress",
        "cssText", "data", "codebase", "location"
      ],
      "accepts":  ["validated-url", "int"]
    }
  },
  "sanitizers": [
    { "name": "escapeHtml",            "removes": ["html"], "sets_state": "html-encoded" },
    { "name": "encodeURI",             "removes": ["html", "ssrf"], "sets_state": "url-encoded" },
    { "name": "encodeURIComponent",    "removes": ["html", "ssrf"], "sets_state": "url-encoded" },
    { "name": "DOMPurify.sanitize",    "removes": ["html"], "sets_state": "html-encoded" },
    { "name": "parseInt",              "removes": ["sql", "html", "ssrf", "shell"], "sets_state": "int" },
    { "name": "parseFloat",            "removes": ["sql", "html", "ssrf"], "sets_state": "float" },
    { "name": "sanitize",              "removes": ["html"], "sets_state": "html-encoded" },
    { "name": "htmlspecialchars",      "removes": ["html"], "sets_state": "html-encoded" },
    { "name": "xss_clean",            "removes": ["html"], "sets_state": "stripped" }
  ],
  "transformers": [
    { "name": "atob",                  "sets_state": "raw" },
    { "name": "btoa",                  "sets_state": "base64" },
    { "name": "decodeURI",             "sets_state": "raw" },
    { "name": "decodeURIComponent",    "sets_state": "raw" },
    { "name": "JSON.parse",            "sets_state": "parsed-object" },
    { "name": "JSON.stringify",        "sets_state": "json-string" },
    { "name": "Buffer.from",           "sets_state": "raw-bytes" }
  ],
  "guards": [
    "typeof", "instanceof",
    "Number.isFinite", "Number.isInteger", "Array.isArray",
    "validator.isEmail", "validator.isURL"
  ]
}
