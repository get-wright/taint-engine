{
  "language": "go",
  "extensions": [".go"],
  "sources": {
    "r.URL.Query":  ["html", "sql", "shell", "ssrf", "redirect"],
    "r.FormValue":  ["html", "sql", "shell", "ssrf"],
    "r.Body":       ["html", "sql", "shell", "ssrf"],
    "os.Getenv":    ["path", "shell"],
    "os.Args":      ["path", "shell", "eval"]
  },
  "sinks": {
    "html": {
      "call":     ["fmt.Fprintf", "template.HTML"],
      "accepts":  ["html-encoded", "int", "float"]
    },
    "sql": {
      "call":     ["db.Query", "db.Exec", "db.QueryRow"],
      "accepts":  ["parameterized", "int", "float"]
    },
    "shell": {
      "call":     ["exec.Command"],
      "accepts":  ["shell-quoted", "int", "float"]
    },
    "redirect": {
      "call":     ["http.Redirect"],
      "accepts":  ["validated-url", "relative-path"]
    },
    "format": {
      "call":     ["fmt.Sprintf"],
      "accepts":  ["int", "float"]
    }
  },
  "sanitizers": [
    { "name": "html.EscapeString",  "removes": ["html"], "sets_state": "html-encoded" },
    { "name": "url.QueryEscape",    "removes": ["html", "ssrf"], "sets_state": "url-encoded" },
    { "name": "filepath.Clean",     "removes": ["path"], "sets_state": "normalized-path" },
    { "name": "filepath.Base",      "removes": ["path"], "sets_state": "basename-only" },
    { "name": "strconv.Atoi",       "removes": ["sql", "html", "ssrf", "shell"], "sets_state": "int" }
  ],
  "transformers": [
    { "name": "base64.StdEncoding.DecodeString", "sets_state": "raw-bytes" },
    { "name": "base64.StdEncoding.EncodeToString", "sets_state": "base64" },
    { "name": "url.QueryUnescape",               "sets_state": "raw" },
    { "name": "json.Unmarshal",                   "sets_state": "parsed-object" },
    { "name": "json.Marshal",                     "sets_state": "json-bytes" }
  ],
  "guards": ["regexp.MatchString", "regexp.MustCompile"]
}
